# Copy to /etc/intentflow/api.env, then root: intentflow-api mode 0640.
# Never place the secret in this unit file or in an ExecStart command line.
INTENTFLOW_API_TOKEN=replace-with-at-least-32-bytes-of-random-secret
INTENTFLOW_ENVIRONMENT=production
INTENTFLOW_AUTH_DISABLED=false
INTENTFLOW_API_HOST=127.0.0.1
INTENTFLOW_API_PORT=8000
INTENTFLOW_COOKIE_SECURE=false
INTENTFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTENTFLOW_RYU_BASE_URL=http://127.0.0.1:8080
INTENTFLOW_WORKER_SOCKET=/run/intentflow/worker.sock
INTENTFLOW_EVIDENCE_JSON_DIR=/var/lib/intentflow/results
INTENTFLOW_EVIDENCE_MARKDOWN_DIR=/var/lib/intentflow/reports
INTENTFLOW_TOPOLOGY_DB=/var/lib/intentflow/topologies/catalog.sqlite3
