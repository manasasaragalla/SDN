# Copy to /etc/intentflow/worker.env, owner root:root, mode 0600.
#
# Generate the required numeric group value in /etc/intentflow/worker.env on
# the target host; do not copy this example unchanged.
# INTENTFLOW_API_GID=<numeric GID from getent group intentflow-api>
LLM_PROVIDER=mock
# Add only the provider/key pair required by the chosen provider:
# GEMINI_API_KEY=replace-me
# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
